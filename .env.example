# Visual Research Board v0.6.1 — free image retrieval + reference search hub
# The app must remain usable without provider keys. Leave optional keys blank unless enabling those providers.

# Server/runtime safe mode. true = force mock-only execution on the server.
VISUAL_RESEARCH_BOARD_MOCK_ONLY=false

# Optional tuning control. true = report recommended tuning but skip the tuned second provider pass.
VISUAL_RESEARCH_BOARD_DISABLE_AUTO_TUNING=false

# Optional evidence-driven tuning control. true = skip evidence-driven query/ranking adjustments.
VISUAL_RESEARCH_BOARD_DISABLE_EVIDENCE_TUNING=false

# Free-key open-access providers. These are disabled by default until a free key is supplied.
SMITHSONIAN_API_KEY=
EUROPEANA_API_KEY=
RIJKSMUSEUM_API_KEY=
NYPL_API_KEY=
DPLA_API_KEY=

# Optional stock/illustrative providers. These are free-key providers, disabled by default, and are not treated as factual evidence sources.
PIXABAY_API_KEY=
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

# Optional legacy/API providers. These are not part of the free-only core and are disabled by default.
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=

# Static demo mode is set by npm run build:static / build:static:pages.
# NEXT_PUBLIC_VISUAL_RESEARCH_BOARD_STATIC_DEMO=true
# VISUAL_RESEARCH_BOARD_STATIC_EXPORT=true
# VISUAL_RESEARCH_BOARD_BASE_PATH=/visual-research-board

# Optional runtime smoke script settings.
# VISUAL_RESEARCH_BOARD_RUNTIME_BASE_URL=http://localhost:3000
# VISUAL_RESEARCH_BOARD_REQUIRE_REAL_PROVIDERS=false
# VISUAL_RESEARCH_BOARD_RUNTIME_TOPICS_FILE=tests/fixtures/provider-runtime-topics.json

# Optional evidence report settings.
# VISUAL_RESEARCH_BOARD_TOPIC_MATRIX_ARTIFACT=artifacts/real-topic-test-matrix.json
# VISUAL_RESEARCH_BOARD_REQUIRE_EVIDENCE_TUNING_PASS=false
