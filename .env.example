# Visual Research Board v0.2.0 stable
# Keep the app usable without keys. Leave blank unless using real providers.

# Server/runtime safe mode. true = force mock-only on the server.
VISUAL_RESEARCH_BOARD_MOCK_ONLY=false

# Optional real providers for Next.js runtime deployments.
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=

# Static demo mode is set by npm run build:static / build:static:pages.
# NEXT_PUBLIC_VISUAL_RESEARCH_BOARD_STATIC_DEMO=true
# VISUAL_RESEARCH_BOARD_STATIC_EXPORT=true
# VISUAL_RESEARCH_BOARD_BASE_PATH=/visual-research-board
